<Window x:Class="PracticalWork5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа. Класс Man"
        Height="620" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F0F4F8" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Класс Man: увеличение возраста и сравнение по весу"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#24476B"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- Два человека -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Человек 1 -->
            <Grid Grid.Column="0" Background="White">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Человек №1"
                               FontSize="15" FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="Name1Box"
                               Height="26" Margin="0,0,0,6"
                               VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Возраст:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="Age1Box"
                               Height="26" Margin="0,0,0,6"
                               VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Пол:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="Gender1Box"
                               Height="26" Margin="0,0,0,6" SelectedIndex="0">
                        <ComboBoxItem Content="Мужской"/>
                        <ComboBoxItem Content="Женский"/>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Вес (кг):"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="Weight1Box"
                               Height="26" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Человек 2 -->
            <Grid Grid.Column="2" Background="White">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Человек №2"
                               FontSize="15" FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="Name2Box"
                               Height="26" Margin="0,0,0,6"
                               VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Возраст:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="Age2Box"
                               Height="26" Margin="0,0,0,6"
                               VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Пол:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="Gender2Box"
                               Height="26" Margin="0,0,0,6" SelectedIndex="1">
                        <ComboBoxItem Content="Мужской"/>
                        <ComboBoxItem Content="Женский"/>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Вес (кг):"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="Weight2Box"
                               Height="26" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Кнопки операций -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,15,0,10">
            <Button Content="Создать людей"   Width="140" Height="32" Margin="4"
                    Click="CreateButton_Click"/>
            <Button Content="День рождения №1" Width="150" Height="32" Margin="4"
                    Click="Birthday1Button_Click"/>
            <Button Content="День рождения №2" Width="150" Height="32" Margin="4"
                    Click="Birthday2Button_Click"/>
            <Button Content="Кто тяжелее / легче" Width="170" Height="32" Margin="4"
                    Click="CompareButton_Click"/>
        </WrapPanel>

        <!-- Результат -->
        <Grid Grid.Row="3" Background="#EAF2FA">
            <TextBlock x:Name="ResultText"
                       Margin="12"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Text="Введите данные двух человек и нажмите «Создать людей»."/>
        </Grid>

        <!-- Нижние кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="О программе" Width="130" Height="32" Margin="5"
                    Click="AboutButton_Click"/>
            <Button Content="Выход" Width="100" Height="32" Margin="5"
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>